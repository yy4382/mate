{
  "name": "@palace/chat",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "palace-source": "./src/index.ts",
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./client": {
      "react-native": "./src/client.ts",
      "palace-source": "./src/client.ts",
      "types": "./dist/src/client.d.ts",
      "default": "./dist/src/client.js"
    },
    "./contracts": {
      "react-native": "./src/contracts.ts",
      "palace-source": "./src/contracts.ts",
      "types": "./dist/src/contracts.d.ts",
      "default": "./dist/src/contracts.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@palace/clock": "workspace:*",
    "@palace/migrations": "workspace:*",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@palace/testkit": "workspace:*"
  }
}
