{
  "name": "@mate/chat",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "mate-source": "./src/index.ts",
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./contracts": {
      "react-native": "./src/contracts.ts",
      "mate-source": "./src/contracts.ts",
      "types": "./dist/src/contracts.d.ts",
      "default": "./dist/src/contracts.js"
    },
    "./push": {
      "react-native": "./src/push-contract.ts",
      "mate-source": "./src/push-contract.ts",
      "types": "./dist/src/push-contract.d.ts",
      "default": "./dist/src/push-contract.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@mate/clock": "workspace:*",
    "@mate/migrations": "workspace:*",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@mate/testkit": "workspace:*"
  }
}
