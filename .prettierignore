# Vendored skill definitions and their lockfile are maintained by the skills tooling.
.agents/
skills-lock.json

# Prose documentation is owned by its own tickets; the formatting pass covers source,
# tests and configuration, where a mechanical change cannot hide a behaviour change.
*.md
docs/

# Generated build output and the generated lockfile.
dist/
coverage/
pnpm-lock.yaml

# Paths that are already outside the project tree; listed so the formatting scope
# does not silently depend on .gitignore, and so `pnpm format` can never rewrite
# another ticket's checkout or a developer's local configuration.
.worktrees/
data/
mate.local.json

# The pnpm content-addressable store: package metadata, never source.
.pnpm-store/
