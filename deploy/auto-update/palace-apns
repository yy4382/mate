#!/bin/bash
set +x
set -euo pipefail
ulimit -c 0
unset OP_SERVICE_ACCOUNT_TOKEN OP_CONNECT_HOST OP_CONNECT_TOKEN apns_private_key

mode=${1:-}
config=${2:-/etc/palace-apns.env}
case "$mode" in check|run) ;; *) echo "usage: palace-apns check|run [config]" >&2; exit 2 ;; esac
# shellcheck source=/dev/null
. "$config"
: "${PALACE_PLANE_DIR:?} ${PALACE_OP_VAULT:?} ${PALACE_OP_DOCUMENT:?} ${PALACE_OP_TOKEN_FILE:?}"
if [ "$(id -u)" != 0 ] || [ "$(stat -c '%u:%a' "$PALACE_OP_TOKEN_FILE")" != 0:600 ]; then
  echo "palace-apns: token must be root-owned with mode 0600" >&2
  exit 1
fi
# Keep private-key process memory out of swap.
if [ -n "$(swapon --show --noheadings --output NAME)" ]; then
  echo "palace-apns: disable swap before loading the private key" >&2
  exit 1
fi
if ! apns_private_key=$(
  (
    export OP_SERVICE_ACCOUNT_TOKEN
    OP_SERVICE_ACCOUNT_TOKEN=$(cat "$PALACE_OP_TOKEN_FILE")
    timeout --kill-after=5s 60s op document get "$PALACE_OP_DOCUMENT" --vault "$PALACE_OP_VAULT"
  ) 2>/dev/null | head -c 16385
); then
  echo "palace-apns: could not fetch APNs credentials" >&2
  exit 1
fi
if [ "${#apns_private_key}" -gt 16384 ] || ! printf '%s' "$apns_private_key" | openssl pkey -check -noout >/dev/null 2>&1; then
  echo "palace-apns: invalid APNs private key" >&2
  exit 1
fi
if ! printf '%s' "$apns_private_key" | openssl pkey -text_pub -noout 2>/dev/null | grep -q 'ASN1 OID: prime256v1'; then
  echo "palace-apns: APNs requires an EC P-256 private key" >&2
  exit 1
fi
if [ "$mode" = check ]; then exit 0; fi

cd "$PALACE_PLANE_DIR"
docker compose create --force-recreate --no-build --pull never control-plane
container=$(docker compose ps --all --quiet control-plane)
if ! [[ "$container" =~ ^[0-9a-f]{12,64}$ ]]; then
  echo "palace-apns: expected one control-plane container" >&2
  exit 1
fi
if [ "$(docker inspect "$container" --format '{{.HostConfig.RestartPolicy.Name}} {{.Config.OpenStdin}} {{.Config.Tty}}')" != 'no true false' ]; then
  echo "palace-apns: configure restart=no, stdin_open=true and tty=false" >&2
  exit 1
fi
cleanup() {
  docker stop --time 20 "$container" >/dev/null 2>&1 || true
}
trap cleanup EXIT
trap 'exit 0' TERM INT
# Background the attachment so Bash handles SIGTERM while the server is running.
(printf '%s' "$apns_private_key" | docker start --attach --interactive "$container") &
attached=$!
unset apns_private_key
if [ -n "${NOTIFY_SOCKET:-}" ]; then systemd-notify --ready; fi
wait "$attached"
