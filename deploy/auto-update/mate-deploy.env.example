# Settings for mate-deploy, at /etc/mate-deploy.env (root-owned).
# The directory holding compose.yaml, .env and data/.
MATE_PLANE_DIR=/srv/mate-control-plane
# The node account; its `mate` command is ~/.local/bin/mate.
MATE_NODE_USER=mate
# The control-plane image without its tag.
MATE_IMAGE_REPO=ghcr.io/yy4382/mate-control-plane
# Where the control plane listens on this host (MATE_LISTEN in .env).
MATE_HEALTH_URL=http://127.0.0.1:8787
# How many data backups under $MATE_PLANE_DIR/backups to keep.
MATE_KEEP_BACKUPS=5
# Seconds the control plane has to become healthy, and the node has to stay running, before a rollback.
MATE_HEALTH_WAIT=30
MATE_NODE_SETTLE=15
