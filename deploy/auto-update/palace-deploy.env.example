# Settings for palace-deploy, at /etc/palace-deploy.env (root-owned).
# The directory holding compose.yaml, .env and data/.
PALACE_PLANE_DIR=/srv/palace-control-plane
# The node account; its `palace` command is ~/.local/bin/palace.
PALACE_NODE_USER=palace
# The control-plane image without its tag.
PALACE_IMAGE_REPO=ghcr.io/yy4382/palace-control-plane
# Where the control plane listens on this host (PALACE_LISTEN in .env).
PALACE_HEALTH_URL=http://127.0.0.1:8787
# How many data backups under $PALACE_PLANE_DIR/backups to keep.
PALACE_KEEP_BACKUPS=5
# Seconds the control plane has to become healthy before a rollback.
PALACE_HEALTH_WAIT=30
# Seconds the restarted node has to report `Link: connected` in `palace node status` before a rollback.
PALACE_NODE_CONNECT_WAIT=60

# Opt in to the systemd service that fetches APNs credentials on every start.
# PALACE_PLANE_SERVICE=palace-control-plane.service
# PALACE_APNS_CONFIG=/etc/palace-apns.env
