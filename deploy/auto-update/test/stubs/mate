#!/bin/bash
# Stub `mate node`, keeping the installed version in ~/ver; a version containing "nostart" never stays active.
set -e
shift
case "$1" in
  status)
    echo "Program: $(cat ~/ver) (linux-x64) in ~/.local/lib/mate-node"
    if [ -f ~/active ]; then echo "Service: active, enabled"; else echo "Service: inactive, disabled"; fi ;;
  stop) rm -f ~/active ;;
  start) grep -q nostart ~/ver || touch ~/active ;;
  update)
    [ ! -f ~/active ] || { echo "refusing: running" >&2; exit 1; }
    (cd "$(dirname "$2")" && sha256sum -c --quiet "$(basename "$2").sha256")
    basename "$2" | sed 's/^mate-node-\(.*\)-linux-x64.tar.gz$/\1/' >~/ver ;;
  logs) echo "(node logs)" ;;
esac
