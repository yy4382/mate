{
  "name": "mate",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "build:protocol": "pnpm --filter @mate/protocol run build",
    "build:node": "pnpm --filter @mate/node... run build",
    "build:web": "pnpm --filter @mate/web run build",
    "build:control-plane": "pnpm --filter @mate/control-plane... run build",
    "typecheck": "pnpm run build && pnpm -r run typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm run build && pnpm -r run test:unit",
    "test:single-account-agent-workspace": "pnpm --filter @mate/node run test:single-account-agent-workspace",
    "test:linux-single-account-node": "pnpm --filter @mate/control-plane run test:linux-single-account-node",
    "test:linux-ordinary-command-failure": "pnpm --filter @mate/node run test:linux-ordinary-command-failure",
    "check": "pnpm run format:check && pnpm test",
    "check:provider": "node apps/control-plane/dist/providers/active-check-cli.js",
    "start": "node apps/control-plane/dist/main.js",
    "start:control-plane": "node apps/control-plane/dist/main.js",
    "start:node": "node apps/node/dist/main.js",
    "dev:web": "pnpm --filter @mate/web run dev"
  },
  "devDependencies": {
    "prettier": "3.9.9",
    "typescript": "7.0.2"
  },
  "packageManager": "pnpm@10.33.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "fs-ext"
    ]
  }
}
