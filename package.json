{
  "name": "mate",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "build": "node --input-type=module -e \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true });\" && tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "pnpm run build && vitest run",
    "check": "pnpm test",
    "start": "node dist/src/main.js start",
    "config:check": "node dist/src/main.js check",
    "deploy": "node dist/src/deployment/cli.js"
  },
  "dependencies": {
    "@anthropic-ai/sandbox-runtime": "0.0.77",
    "@earendil-works/pi-agent-core": "0.86.0",
    "@earendil-works/pi-ai": "0.86.0",
    "@emoji-mart/data": "1.2.1",
    "@slack/bolt": "5.1.0",
    "@slack/socket-mode": "3.0.1",
    "@slack/web-api": "8.1.1",
    "better-sqlite3": "13.0.3",
    "cron-parser": "5.10.1",
    "drizzle-orm": "0.45.2",
    "fs-ext": "2.1.1",
    "pino": "10.3.1",
    "typebox": "1.3.27",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/fs-ext": "2.0.3",
    "@types/node": "24.13.6",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  },
  "packageManager": "pnpm@10.33.0"
}
