{
  "name": "mate",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "build": "pnpm run build:web && pnpm run build:control-plane && node --input-type=module -e \"import { cpSync } from 'node:fs'; cpSync('apps/web/dist', 'dist/web', { recursive: true });\"",
    "build:web": "pnpm --filter @mate/web run build",
    "build:control-plane": "node --input-type=module -e \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true });\" && tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit && pnpm --filter @mate/web run typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm run build && vitest run",
    "check": "pnpm run format:check && pnpm test",
    "start": "node dist/src/main.js start",
    "start:control-plane": "node dist/src/control-plane/main.js",
    "dev:web": "pnpm --filter @mate/web run dev",
    "config:check": "node dist/src/main.js check",
    "deploy": "node dist/src/deployment/cli.js"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "0.86.0",
    "@earendil-works/pi-ai": "0.86.0",
    "@emoji-mart/data": "1.2.1",
    "@hono/node-server": "2.1.1",
    "@slack/bolt": "5.1.0",
    "@slack/socket-mode": "3.0.1",
    "@slack/web-api": "8.1.1",
    "argon2": "0.45.0",
    "better-sqlite3": "13.0.3",
    "cron-parser": "5.10.1",
    "fs-ext": "2.1.1",
    "hono": "4.13.7",
    "pino": "10.3.1",
    "typebox": "1.3.27",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/fs-ext": "2.0.3",
    "@types/node": "24.13.6",
    "prettier": "3.9.9",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  },
  "packageManager": "pnpm@10.33.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "fs-ext"
    ]
  }
}
