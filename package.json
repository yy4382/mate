{
  "name": "mate",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "build": "pnpm run build:web && pnpm run build:control-plane && node --input-type=module -e \"import { cpSync } from 'node:fs'; cpSync('apps/web/dist', 'dist/web', { recursive: true });\"",
    "build:web": "pnpm --filter @mate/web run build",
    "build:control-plane": "pnpm run build:protocol && node --input-type=module -e \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true });\" && tsc -p tsconfig.json && node scripts/build-rename-noreplace.mjs",
    "typecheck": "pnpm run build:protocol && pnpm --filter @mate/protocol run typecheck && tsc --noEmit && pnpm --filter @mate/web run typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm run build && vitest run",
    "test:single-account-agent-workspace": "node tests/linux/agent-workspace-preparation.integration.mjs",
    "test:linux-single-account-node": "node tests/linux/single-account-node.integration.mjs",
    "test:linux-ordinary-command-failure": "node tests/linux/ordinary-command-failure.integration.mjs",
    "check": "pnpm run format:check && pnpm test",
    "start": "node dist/src/control-plane/main.js",
    "start:control-plane": "node dist/src/control-plane/main.js",
    "start:node": "node dist/src/node/main.js",
    "dev:web": "pnpm --filter @mate/web run dev",
    "build:protocol": "pnpm --filter @mate/protocol run build"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "0.86.0",
    "@earendil-works/pi-ai": "0.86.0",
    "@emoji-mart/data": "1.2.1",
    "@hono/node-server": "2.1.1",
    "argon2": "0.45.0",
    "better-sqlite3": "13.0.3",
    "cron-parser": "5.10.1",
    "fs-ext": "2.1.1",
    "hono": "4.13.7",
    "pino": "10.3.1",
    "typebox": "1.3.27",
    "web-push": "3.6.7",
    "ws": "8.21.3",
    "zod": "4.6.5",
    "@mate/protocol": "workspace:*"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/better-sqlite3": "9.6.0",
    "@types/fs-ext": "2.0.3",
    "@types/node": "24.13.6",
    "@types/web-push": "3.6.4",
    "@types/ws": "8.18.1",
    "jsdom": "^30.1.1",
    "prettier": "3.9.9",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  },
  "packageManager": "pnpm@10.33.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "fs-ext"
    ]
  }
}
