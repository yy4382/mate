{
  "name": "mate",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "check": "pnpm format:check && pnpm typecheck && pnpm test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r run typecheck",
    "test": "vitest run",
    "test:linux": "sh scripts/test-linux.sh",
    "build": "pnpm -r run build"
  },
  "devDependencies": {
    "@types/node": "24.13.6",
    "prettier": "3.9.9",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  }
}
