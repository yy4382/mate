{
  "version": 2,
  "mate": {
    "ownerUserIds": ["owner"],
    "runTimeoutMs": 180000,
    "agents": [
      {"id": "research", "name": "Research", "role": "Find primary evidence, challenge assumptions, and record reusable findings.", "model": {"provider": "anthropic", "id": "claude-haiku-4-5", "apiKeyEnv": "MODEL_API_KEY"}},
      {"id": "writer", "name": "Writer", "role": "Independently verify evidence, revise drafts, and deliver clear artifacts.", "model": {"provider": "anthropic", "id": "claude-haiku-4-5", "apiKeyEnv": "MODEL_API_KEY"}}
    ]
  },
  "adapters": {
    "slack": {
      "teamId": "TEXAMPLE",
      "principals": {"UOWNER": "owner"},
      "bindings": [
        {"agentId": "research", "slackAppId": "ARESEARCH", "slackUserId": "URESEARCH", "slackBotId": "BRESEARCH", "botTokenEnv": "RESEARCH_BOT_TOKEN", "appTokenEnv": "RESEARCH_APP_TOKEN", "channels": {"CEXAMPLE": "mentions"}},
        {"agentId": "writer", "slackAppId": "AWRITER", "slackUserId": "UWRITER", "slackBotId": "BWRITER", "botTokenEnv": "WRITER_BOT_TOKEN", "appTokenEnv": "WRITER_APP_TOKEN", "channels": {"CEXAMPLE": "mentions"}}
      ]
    }
  },
  "runtime": {"dataDir": "/var/lib/mate", "sharedRoot": "/srv/mate/shared", "linuxUsers": {"research": {"uid": 2001, "gid": 2001, "username": "mate-research", "home": "/srv/mate/private/research"}, "writer": {"uid": 2002, "gid": 2002, "username": "mate-writer", "home": "/srv/mate/private/writer"}}, "systemAgents": [], "limits": {"maxActiveRuns": 1, "maxBackendOperations": 1, "workerIdleMs": 300000}, "researchHosts": ["example.com"]}
}
