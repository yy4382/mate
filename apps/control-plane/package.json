{
  "name": "@mate/control-plane",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./main": {
      "types": "./dist/main.d.ts",
      "import": "./dist/main.js"
    }
  },
  "scripts": {
    "build": "node --input-type=module -e \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true });\" && tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.tests.json",
    "test": "pnpm --filter @mate/control-plane... --filter @mate/node... run build && vitest run",
    "start": "node dist/main.js",
    "test:linux-single-account-node": "node tests/linux/single-account-node.integration.mjs",
    "test:unit": "vitest run"
  },
  "dependencies": {
    "@earendil-works/chord": "1.1.0",
    "@earendil-works/pi-ai": "1.1.0",
    "@earendil-works/pi-durable": "1.1.0",
    "@hono/node-server": "2.1.1",
    "@mate/protocol": "workspace:*",
    "@mate/web": "workspace:*",
    "argon2": "0.45.0",
    "better-sqlite3": "13.0.3",
    "hono": "4.13.7",
    "web-push": "3.6.7",
    "ws": "8.21.3",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@mate/node": "workspace:*",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "24.13.6",
    "@types/web-push": "3.6.4",
    "@types/ws": "8.18.1",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  },
  "files": [
    "dist"
  ]
}
