          "minimum": 1,
          "maximum": 32
        }
      },
      "required": ["path", "offset", "limit"],
      "additionalProperties": false
    }
  },
  {
    "name": "workspace.stat",
    "description": "查看工作区中文件或目录的类型和大小；路径规则与 workspace.read 相同。",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "maxLength": 4096
        }
      },
      "required": ["path"],
      "additionalProperties": false
    }
  },
  {
    "name": "workspace.read",
    "description": "读取不超过 8 KiB 的 UTF-8 文本，或不超过 5 MiB 的完整 PNG/JPEG/GIF/WebP 图片（模型须支持图片输入）；其它二进制返回类型与不可读取提示。类型按字节判断。相对路径从你的工作区开始，也可以用同伴的 Agent ID（见 agents.list）按路径读取同伴工作区。更大的文本使用 workspace.read_chunk。",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "maxLength": 4096
        }
      },
      "required": ["path"],
      "additionalProperties": false
    }
  },
  {
    "name": "workspace.read_chunk",
    "description": "按字节范围读取 UTF-8 文本，路径规则与 workspace.read 相同；请求每次最多 8 KiB，字符边界各最多扩展 3 字节。返回 content、实际 offset/nextOffset、requestedOffset/requestedLength 与 version；继续读取用 nextOffset 和 version。二进制仅返回类型提示，完整图片用 workspace.read。",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "maxLength": 4096
        },
        "offset": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "length": {
          "default": 8192,
          "type": "integer",
          "minimum": 1,
          "maximum": 8192
        },
        "version": {
          "type": "object",
          "properties": {
            "device": {
              "type": "string",
              "pattern": "^[0-9]+$"
            },
            "inode": {
              "type": "string",
              "pattern": "^[0-9]+$"
            },
            "size": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "modifiedNs": {
              "type": "string",
              "pattern": "^[0-9]+$"
            },
            "changedNs": {
              "type": "string",
              "pattern": "^[0-9]+$"
            }
          },
          "required": ["device", "inode", "size", "modifiedNs", "changedNs"],
          "additionalProperties": false
        }
      },
      "required": ["path", "offset", "length"],
      "additionalProperties": false
    }
  },
  {
    "name": "workspace.write",
